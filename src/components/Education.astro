---
import { siteConfig } from "../config";
import { t } from '../i18n';
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 data-i18n="headings.education" class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              {t('headings.education')}
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-8">
              {siteConfig.education.map((edu, index) => (
                <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4 sm:p-5 md:p-6 hover:shadow-md transition-shadow duration-300">
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-x-4 mb-4">
                    <div class="min-w-0">
                      <h3 data-i18n={`education.${index}.degree`} class="text-lg sm:text-xl font-semibold text-gray-900">
                        {t(`education.${index}.degree`)}
                      </h3>
                      <p
                        data-i18n={`education.${index}.school`}
                        class="text-base sm:text-lg"
                        style={`color: ${siteConfig.accentColor}`}
                      >
                        {t(`education.${index}.school`)}
                      </p>
                    </div>
                    <span dir="auto" data-i18n={`education.${index}.dateRange`} class="shrink-0 text-xs sm:text-sm text-gray-500 mt-2 sm:mt-0">
                      {t(`education.${index}.dateRange`)}
                    </span>
                  </div>

                  <ul class="space-y-2">
                    {edu.achievements.map((_, achievementIndex) => (
                      <li class="flex items-start">
                        <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 me-3 flex-shrink-0" />
                        <span data-i18n={`education.${index}.achievements.${achievementIndex}`} class="text-sm sm:text-base text-gray-600">
                          {t(`education.${index}.achievements.${achievementIndex}`)}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
